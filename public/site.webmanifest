{
  "id": "/",
  "name": "Hullpatch",
  "short_name": "Hullpatch",
  "description": "In-browser STL repair that makes files slice cleanly in Bambu Studio.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070a18",
  "theme_color": "#070a18",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "model/stl": [".stl"] },
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "stl", "accept": [".stl", "model/stl", "application/sla", "application/vnd.ms-pki.stl", "application/octet-stream"] }
      ]
    }
  }
}
